# Copy to .env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://clockit:clockit@localhost:5432/clockit

# --- Auth / JWT -------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE-ME
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth client IDs (must match the mobile app + dashboard) --------
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# GOOGLE_EXTRA_CLIENT_IDS=another.apps.googleusercontent.com,and-another...

# Restrict sign-in to one company domain (optional). Empty = any Google account.
ALLOWED_EMAIL_DOMAIN=

# --- Shift rules (mirror Mobile_App/src/config/attendance.ts) ---------------
SHIFT_START_HOUR=8
SHIFT_START_MINUTE=30
SHIFT_GRACE_MINUTES=5

# --- CORS -------------------------------------------------------------------
# Comma-separated dashboard origins, or * for any.
CORS_ORIGINS=http://localhost:3000

# --- Local development ------------------------------------------------------
# true enables POST /auth/dev-login (mint tokens without Google). NEVER in prod.
DEV_MODE=false
