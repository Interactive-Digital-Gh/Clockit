# Copy to .env.local and fill in. NEXT_PUBLIC_ vars are inlined at build time —
# the production values are set in .github/workflows/deploy-dashboard.yml, not
# on the server.

# The Clockit API.
#   Production:  https://clockit-api.interactivedigital.com.gh
#   Local:       http://localhost:8010
NEXT_PUBLIC_API_URL=

# Google OAuth "Web application" client ID (Google Cloud Console → APIs &
# Services → Credentials). Looks like 1234567890-abc.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
