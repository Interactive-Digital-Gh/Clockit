# Copy to .env. Point the app at the Clockit backend.
#   Production:            https://clockit-api.yourdomain
#   Local phone testing:   http://<your-laptop-LAN-IP>:8010  (phone on same WiFi)
# EXPO_PUBLIC_ vars are inlined into the app at build/start time.
EXPO_PUBLIC_API_URL=

# Google OAuth client IDs (Google Cloud Console → APIs & Services → Credentials).
# WEB = the "Web application" client ID; IOS = the "iOS" client ID for
# bundle ID com.interactivedigital.clockit.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
